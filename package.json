{
  "name": "captchano-captcha-solver",
  "version": "1.0.0",
  "description": "Apify Actor: solve reCAPTCHA v2/v3/Enterprise, Cloudflare Turnstile, DataDome and image captchas with the CaptchaNo API.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "validate-schemas": "node test/validate-schemas.mjs"
  },
  "dependencies": {
    "apify": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "author": "DishIs Technologies LLC <support@captchano.com>",
  "homepage": "https://captchano.com",
  "license": "MIT",
